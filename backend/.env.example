# Backend Server Configuration
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nwis

# JWT Secret for Session Authentication
JWT_SECRET=nwis_jwt_secret_dev_key_2026_change_in_production

# Python ML Microservice URL (FastAPI on port 8000)
ML_PREDICT_URL=http://localhost:8000/predict
ML_EXPLAIN_URL=http://localhost:8000/explain
ML_REALTIME_WARNING_URL=http://localhost:8000/realtime-warning

# Python WellMind RAG Microservice URL (FastAPI on port 8001)
WELLMIND_URL=http://localhost:8001

# Optional Google OAuth Client ID for Google Sign-In
GOOGLE_CLIENT_ID=
