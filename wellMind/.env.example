# WellMind RAG Service Configuration
PORT=8001

# Qdrant Vector Database
# For Qdrant Cloud, provide the URL and API key
# Example: https://xxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=nwis_knowledge_repository

# Hugging Face Token for Llama-3.1 Inference API
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
